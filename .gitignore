# Root-level rules only.  Each vendored engine keeps its own .gitignore, and git
# honours it inside that directory - so a file that looks like an artefact here
# (a tracked stdout.txt, a placeholder .g00) stays tracked, and a new source file
# added upstream is not silently left out of a sync.

# game data never belongs in this repository (see docs/DATA.md)
testdata/

# build output
*/build/
*/build-*/
*/obj/
.sconsign.dblite
.sconf_temp/
config.log
__pycache__/
*.pyc

# produced by running the engines
*.dmg
frames/
verify-out/
shots/
*.bmp

# fuzz crash samples are regenerated by the harness and one of them is 100 MB,
# past what a single git object may be
artemis/tests/fuzz/crashes/
artemis/tests/artifacts/

# editor / OS
.DS_Store
