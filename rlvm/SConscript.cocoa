# Builds the rlvm.app with all binaries and files.

import re

Import('env')

static_env = env.Clone()
static_env.Append(
  CPPDEFINES = [
    "CASE_SENSITIVE_FILESYSTEM",
    "_THREAD_SAFE"
  ],

  CXXFLAGS = [
    "--ansi",
    "-Wall",
    "-Wno-sign-compare",
    "-Wno-narrowing",
    "-std=c++17"
  ],

  # The bundle must run on machines without Homebrew: Contents/Frameworks
  # joins the dyld search path through this rpath, both for the loads we
  # rewrite and for the bare dlopen() sdl12-compat aims at its backend.
  LINKFLAGS = ["-Wl,-rpath,@executable_path/../Frameworks"]
)

def MergeEverythingButSDLMain(env, cmd, unique = 0):
  """
  Filters out the libSDLmain.a argument from the return value of sdl-config.
  """
  p = re.compile('libSDLmain')
  def isSDLMain(x):
    return not p.search(x)
  # list(): filter() is an iterator in Python 3, and MergeFlags must see
  # every flag, not the tail of an iterator that join() just consumed.
  filtered_args = list(filter(isSDLMain, cmd.split(' ')))
  # SCons >= 3.1 hands its merge callbacks the caller's unique flag.
  return env.MergeFlags(filtered_args, unique)

# Modern sdl-config (sdl12-compat included) speaks "--libs"; there is no
# static SDL left anywhere to link an app bundle against.
static_env.ParseConfig("sdl-config --libs", MergeEverythingButSDLMain)

cocoarlvm_files = [
  # Technically cross platform, but put here for SDL dependency.
  "src/machine/rlvm_instance.cc",

  "src/platforms/osx/CocoaRLVMInstance.mm",
  "src/platforms/osx/SDLMain.mm"
]

# Builds a fullstatic version of rlvm and then builds a bundle
static_env.RlvmProgram('rlvm-static', cocoarlvm_files,
                       use_lib_set = ["SDL"],
                       full_static_build = True,
                       rlvm_libs = ["guichan_platform", "system_sdl", "rlvm"])

# The bundle's contents, gathered as dependencies for the fixup below.
bundle_inputs = ['rlvm-static']
bundle_inputs += static_env.InstallAs(
  target='$OUTPUT_DIR/rlvm.app/Contents/Info.plist',
  source='src/platforms/osx/Info.plist.in')
bundle_inputs += static_env.Install(
  target='$OUTPUT_DIR/rlvm.app/Contents/Resources/',
  source=["COPYING.TXT", "LICENSE.txt", "README.md",
          'resources/rlvm.icns', '$OUTPUT_DIR/locale/'])
bundle_inputs += static_env.InstallAs(
  target='$OUTPUT_DIR/rlvm.app/Contents/Resources/'
         'Japanese.lproj/InfoPlist.strings',
  source='src/platforms/osx/StubInfoPlist.strings')
bundle_inputs += static_env.InstallAs(
  target='$OUTPUT_DIR/rlvm.app/Contents/Resources/'
         'English.lproj/InfoPlist.strings',
  source='src/platforms/osx/StubInfoPlist.strings')

# Homebrew will not exist on the machines this bundle visits: the fixup
# installs the binary and carries the third-party dylibs home, repointing
# every load at @rpath. libSDL3 is invisible to otool -- sdl12-compat
# dlopen()s it by bare name -- so it is named out loud; the bundle rpath
# above is what lets that dlopen hit. The fixup depends on every file the
# bundle will carry, because it signs the whole thing when it runs.
brew = env.get('BREW_PREFIX', '/opt/homebrew')
static_env.Command(
  '$OUTPUT_DIR/rlvm.app/Contents/Frameworks/.bundle-fixed',
  bundle_inputs,
  # Literal "build/", as in the pkg-dmg line below: $OUTPUT_DIR expands
  # to "#/build/" in an action string, and sh reads the '#' as a comment.
  # sdl12-compat finds no backend by itself: it dlopens libSDL2-2.0.0.dylib
  # from beside itself, and that (sdl2-compat) in turn dlopens libSDL3.dylib.
  # Neither appears in any load command, so both are named out loud here.
  "scripts/bundle-dylibs.sh $SOURCE build/rlvm.app "
  + brew + "/opt/sdl2-compat/lib/libSDL2-2.0.0.dylib "
  + brew + "/opt/sdl3/lib/libSDL3.0.dylib")

AddOption('--dmgname', action='store',
          help='Builds a release package with the attached name. '
               '(Example: "rlvm 0.12" -> "rlvm_0.12.dmg"')

if GetOption('dmgname'):
  dmgname = GetOption('dmgname')
  filename = dmgname.replace(' ', '_') + ".dmg"
  if not GetOption('fullstatic'):
    print("**** WARNING: RELEASE BUILDS MUST HAVE --fullstatic ****")
    Exit(1)

  static_env.Command('$OUTPUT_DIR/' + filename,
                     '$OUTPUT_DIR/rlvm.app/',
                     "scripts/pkg-dmg "
                     "  --tempdir build/"
                     "  --source build/rlvm.app"
                     "  --target build/" + filename +
                     "  --sourcefile"
                     "  --volname \"" + dmgname + "\""
                     "  --copy src/platforms/osx/dmg-ds-store:/.DS_Store"
                     "  --format UDBZ")
