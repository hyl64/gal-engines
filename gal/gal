class ProbeError(Exception):
    pass


def ffmpeg_bin():
    return os.environ.get("GAL_FFMPEG_BIN") or shutil.which("ffmpeg")


def ffprobe_bin():
    return os.environ.get("GAL_FFPROBE_BIN") or shutil.which("ffprobe")


def _parse_ratio(text):
    """'16:11' or '30000/1001' -> (num, den); anything unusable -> None."""
    if not text:
        return None
    for sep in (":", "/"):
        if sep in text:
            a, _, b = text.partition(sep)
            try:
                n, d = int(a), int(b)
            except ValueError:
                return None
            if d <= 0 or n <= 0:
                return None
            return n, d
    return None


def _round_even(x, minimum=2):
    v = int(round(x))
    if v % 2:
        v -= 1
    return max(minimum, v)


def human_bytes(n):
    if n is None:
        return "-"
    n = float(n)
    for unit in ("B", "KiB", "MiB", "GiB"):
        if n < 1024 or unit == "GiB":
            return f"{n:.0f}{unit}" if unit == "B" else f"{n:.1f}{unit}"
        n /= 1024.0


def human_dur(sec):
    if sec is None:
        return "-"
    return f"{sec:.1f}s"


def probe_media(path):
    """ffprobe a file; return the fields the pipeline needs, or raise."""
    exe = ffprobe_bin()
    if not exe:
        raise ProbeError("ffprobe 不存在（brew install ffmpeg）")
    argv = [exe, "-v", "error", "-print_format", "json",
            "-show_streams", "-show_format", path]
    try:
        proc = subprocess.run(argv, capture_output=True, text=True,
                              errors="replace", timeout=PROBE_TIMEOUT)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise ProbeError(f"ffprobe 启动失败: {e}")
    if proc.returncode != 0:
        raise ProbeError((proc.stderr or "").strip().splitlines()[-1]
                         if proc.stderr else "ffprobe 非零退出")
    try:
        data = json.loads(proc.stdout or "{}")
    except ValueError as e:
        raise ProbeError(f"ffprobe 输出不是 JSON: {e}")
    streams = data.get("streams") or []
    v = next((s for s in streams if s.get("codec_type") == "video"), None)
    if v is None:
        raise ProbeError("没有视频流")
    a = next((s for s in streams if s.get("codec_type") == "audio"), None)
    fmt = data.get("format") or {}

    def first_float(*vals):
        for v_ in vals:
            try:
                f = float(v_)
            except (TypeError, ValueError):
                continue
            if f > 0:
                return f
        return None

    duration = first_float(fmt.get("duration"), v.get("duration"),
                           a.get("duration") if a else None)
    fps = _parse_ratio(v.get("avg_frame_rate")) or _parse_ratio(v.get("r_frame_rate"))
    return {
        "codec": v.get("codec_name"),
        "width": v.get("width"),
        "height": v.get("height"),
        "sar": v.get("sample_aspect_ratio") or "1:1",
        "dar": v.get("display_aspect_ratio"),
        "fps": (fps[0] / fps[1]) if fps else None,
        "field_order": v.get("field_order") or "unknown",
        "has_audio": a is not None,
        "audio_codec": a.get("codec_name") if a else None,
        "duration": duration,
    }


def target_size(info):
    """Display size in square pixels, rounded to even, from coded size + SAR."""
    w, h = info.get("width"), info.get("height")
    if not w or not h:
        raise ProbeError("ffprobe 没有给出分辨率")
    sar = _parse_ratio(info.get("sar")) or (1, 1)
    return _round_even(w * sar[0] / sar[1]), _round_even(h)


def build_vf(info):
    parts = []
    if info.get("field_order") not in (None, "progressive", "unknown"):
        parts.append("yadif=0:-1:0")
    tw, th = target_size(info)
    if (tw, th) != (info["width"], info["height"]):
        parts.append(f"scale={tw}:{th}")
    parts.append("setsar=1")
    return ",".join(parts), (tw, th)


def pick_bitrate(width, height, fps):
    """~0.08 bits per pixel per frame for the hardware pass, clamped."""
    bps = int(width * height * (fps or 25) * 0.08)
    return f"{max(500_000, min(bps, 10_000_000))}"


def ffmpeg_argv(src, dst, info, encoder, vf, size):
    argv = [ffmpeg_bin(), "-y", "-hide_banner", "-nostdin", "-loglevel", "error",
            "-i", src, "-map", "0:v:0"]
    if info["has_audio"]:
        argv += ["-map", "0:a:0?", "-c:a", "aac", "-b:a", "128k"]
    else:
        argv += ["-an"]
    argv += ["-vf", vf]
    tw, th = size
    if encoder == "h264_videotoolbox":
        argv += ["-c:v", encoder,
                 "-realtime", "0",
                 "-b:v", pick_bitrate(tw, th, info["fps"]),
                 "-profile:v", "high"]
    else:
        argv += ["-c:v", encoder, "-preset", "veryfast", "-crf", "23",
                 "-pix_fmt", "yuv420p", "-profile:v", "high"]
    argv += ["-movflags", "+faststart", dst]
    return argv


def run_one_attempt(src, dst, info, encoder, vf, size):
    """One ffmpeg pass; True on success, (False, error_tail) otherwise."""
    tmp = dst + ".part.mp4"
    argv = ffmpeg_argv(src, tmp, info, encoder, vf, size)
    timeout = float(os.environ.get("GAL_PREP_FFMPEG_TIMEOUT", FFMPEG_TIMEOUT))
    started = time.monotonic()
    try:
        proc = subprocess.run(argv, capture_output=True, text=True,
                              errors="replace", timeout=timeout)
        rc, err = proc.returncode, proc.stderr
    except subprocess.TimeoutExpired:
        _quiet_unlink(tmp)
        return False, f"ffmpeg 超时（>{timeout:.0f}s）", 0.0
    except OSError as e:
        _quiet_unlink(tmp)
        return False, f"ffmpeg 启动失败: {e}", 0.0
    elapsed = time.monotonic() - started
    if rc == 0 and os.path.exists(tmp) and os.path.getsize(tmp) > 0:
        os.replace(tmp, dst)
        return True, "", elapsed
    _quiet_unlink(tmp)
    tail = (err or "").strip().splitlines()[-3:]
    return False, " | ".join(tail) or f"ffmpeg 退出码 {rc}", elapsed


def _quiet_unlink(path):
    try:
        os.unlink(path)
    except OSError:
        pass


def transcode_one(src, dst, info):
    """Hardware attempt, then the libx264 retry.  Returns a record dict."""
    vf, size = build_vf(info)
    attempts = []
    chain = []
    if os.environ.get("GAL_PREP_SOFT_ONLY") != "1":
        chain.append("h264_videotoolbox")
    chain.append("libx264")
    record = {"status": "failed", "encoder": None, "elapsed_sec": None,
              "attempts": attempts, "error": None, "filter": vf,
              "target": f"{size[0]}x{size[1]}"}
    total = 0.0
    for enc in chain:
        ok, err, el = run_one_attempt(src, dst, info, enc, vf, size)
        total += el
        attempts.append({"encoder": enc, "ok": ok, "error": err or None,
                         "elapsed_sec": round(el, 2)})
        if ok:
            record.update(status="transcoded", encoder=enc,
                          elapsed_sec=round(el, 2))
            return record
        record["error"] = err
    record["elapsed_sec"] = round(total, 2)
    return record


def should_skip(src, dst):
    """Idempotence: newer non-empty target that ffprobe still reads."""
    try:
        if not (os.path.exists(dst) and os.path.getsize(dst) > 0):
            return False
        if os.path.getmtime(dst) < os.path.getmtime(src):
            return False
    except OSError:
        return False
    try:
        probe_media(dst)
    except ProbeError:
        return False
    return True


def find_videos(game_root):
    """Loose *.avi/.mpg/.mpeg under the game root, case-insensitive.

    Returns (disk_rel, map_from) pairs, sorted by map_from.  disk_rel is the
    path as it exists on disk; map_from is the contract spelling - relative
    to the game root, '/' separators, '\\' folded to '/' (NScripter scripts
    use either).  _video/ (our own output) and dot-directories are skipped."""
    out = []
    for root, dirs, files in os.walk(game_root):
        dirs[:] = [d for d in sorted(dirs)
                   if not d.startswith(".")
                   and os.path.join(root, d) != os.path.join(game_root, VIDEO_OUT_DIR)]
        for f in files:
            if f.lower().endswith(VIDEO_EXTS):
                disk = os.path.relpath(os.path.join(root, f), game_root)
                norm = disk.replace(os.sep, "/").replace("\\", "/")
                out.append((disk, norm))
    return sorted(out, key=lambda p: p[1])


# --- NSA/NS2 archives ------------------------------------------------------
#
# Real NScripter games are not supposed to archive their movies, but Chinese
# repacks and dōjin titles do it anyway.  `gal prep` therefore also opens the
# root *.nsa/*.ns2, and every entry that either ends in a video extension or
# sniffs as a movie (RIFF/AVI, the NScripter 'AVI8' wrapper, MPEG pack or
# sequence start) is extracted to _video/extracted/ and put through the same
# transcode chain.  The header layout is parsed exactly as the engine reads
# it (OnscripterYuri/src/onsyuri/{Sar,Direct}Reader.cpp):
#   NSA: num(u16 BE) base(u32 BE) then per entry  name\0 comp(u8)
#        offset(u32 BE, +base) length(u32 BE) orig_length(u32 BE)
#   NS2: base(u32 LE) then per entry  "name" length(u32 LE), data laid
#        out flat from base, no compression byte.
# Compressed entries (comp != 0) need the engine's own decoder: the tool
# nsadec (build: gal/prep/tools/build-nsatools.sh) is used as a fallback when
# present; without it those entries are reported skipped_compressed, honestly.

NSA_EXTS = (".nsa", ".ns2")
NSA_EXTRACT_DIR = os.path.join(VIDEO_OUT_DIR, "extracted")
NSA_SNIFF_BYTES = 4096
NSADECODE_TIMEOUT = 300


class NsaError(Exception):
    pass


def _nsadec_bin():
    env = os.environ.get("GAL_NSADEC")
    if env:
        return env
    here = os.path.dirname(os.path.abspath(__file__ if "__file__" in globals() else "."))
    return os.path.join(here, "prep", "tools", "nsadec")


def sniff_video_payload(head):
    """0 for a bare movie at the start, >0 for a wrapper offset to strip,
    None when the bytes do not look like a movie."""
    if len(head) < 12:
        return None
    if head[:4] == b"RIFF" and head[8:12] == b"AVI ":
        return 0
    if head[:4] == b"AVI8":            # NScripter's wrapped-avi in archive
        i = head.find(b"RIFF", 4)
        return i if i >= 0 else None
    if head[:4] == b"\x00\x00\x01\xba":   # MPEG-2 PS pack start
        return 0
    if head[:4] == b"\x00\x00\x01\xb3":   # MPEG-1 video sequence header
        return 0
    return None


def nsa_list_entries(path):
    """Parse an .nsa/.ns2 header; return [(name, offset, length, comp)]."""
    ns2 = path.lower().endswith(".ns2")
    try:
        size = os.path.getsize(path)
        with open(path, "rb") as f:
            if ns2:
                base = int.from_bytes(f.read(4), "little")
                if not (0 <= base < size):
                    raise NsaError("NS2 base_offset 越界")
                ents = []
                cur = base
                while True:
                    ch = f.read(1)
                    if not ch:
                        break
                    if ch != b'"':
                        break
                    nm = bytearray()
                    while True:
                        c = f.read(1)
                        if not c or c == b'"':
                            break
                        nm.append(c[0])
                    ln4 = f.read(4)
                    if len(ln4) < 4:
                        break
                    ln = int.from_bytes(ln4, "little")
                    name = nm.decode("utf-8", "replace")
                    ents.append((name, cur, ln, 0))
                    cur += ln
                return ents
            num = int.from_bytes(f.read(2), "big")
            base = int.from_bytes(f.read(4), "big")
            if num > 500000 or not (0 <= base < size):
                raise NsaError(f"NSA 头越界（num={num} base={base}）")
            ents = []
            for _ in range(num):
                nm = bytearray()
                while True:
                    c = f.read(1)
                    if not c:
                        raise NsaError("NSA 头截断")
                    if c == b"\x00":
                        break
                    nm.append(c[0])
                comp = f.read(1)[0]
                off = int.from_bytes(f.read(4), "big") + base
                ln = int.from_bytes(f.read(4), "big")
                f.read(4)  # original length
                name = nm.decode("utf-8", "replace")
                if off + ln > size:
                    raise NsaError(f"条目 {name} 越出文件")
                ents.append((name, off, ln, comp))
            return ents
    except NsaError:
        raise
    except (OSError, IndexError) as e:
        raise NsaError(str(e))


def nsa_video_entries(game_root):
    """Archive candidates for this game root.

    Returns (items, broken_archives) where items are
    (archive_rel, entry_name_norm, offset, length, comp, strip) for every
    entry that either names itself a movie or sniffs as one, and
    broken_archives lists archive files whose header did not parse.
    Compressed movie-named entries carry comp != 0; they are decoded with
    nsadec later, only when the tool is available."""
    items, broken = [], []
    try:
        names = sorted(n for n in os.listdir(game_root)
                       if n.lower().endswith(NSA_EXTS))
    except OSError:
        return items, broken
    for arc in names:
        path = os.path.join(game_root, arc)
        try:
            ents = nsa_list_entries(path)
        except NsaError:
            broken.append(arc)
            continue
        for (name, off, ln, comp) in ents:
            norm = name.replace("\\", "/")
            strip = 0
            if not norm.lower().endswith(VIDEO_EXTS):
                if comp != 0:
                    continue     # cannot sniff a compressed payload cheaply
                try:
                    with open(path, "rb") as f:
                        f.seek(off)
                        head = f.read(min(NSA_SNIFF_BYTES, ln))
                except OSError:
                    continue
                s = sniff_video_payload(head)
                if s is None:
                    continue
                strip = s
            items.append((arc, norm, off + strip, max(0, ln - strip), comp, strip))
    return items, broken


def strip_extracted(path, n):
    """Drop an n-byte wrapper (the NScripter 'AVI8' header ahead of RIFF)
    from a decoded payload, in place.  n==0 is a no-op; an OSError just keeps
    the file as-is and lets probe/transcode report it honestly."""
    if not n:
        return path
    try:
        if os.path.getsize(path) <= n:
            return path
        tmp = path + ".part"
        with open(path, "rb") as f:
            f.seek(n)
            data = f.read()
        with open(tmp, "wb") as g:
            g.write(data)
        os.replace(tmp, path)
    except OSError:
        pass
    return path


def extract_nsa_entry(game_root, arc, name, offset, length, dst_dir):
    """Write _video/extracted/<arc>!<name> raw (no compression); returns the
    path.  Idempotent: reused when newer than the archive and intact-sized."""
    disk_name = (arc + "!" + name).replace("/", "_").replace("\\", "_")
    dst = os.path.join(dst_dir, disk_name)
    src = os.path.join(game_root, arc)
    if (os.path.exists(dst) and os.path.getsize(dst) == length
            and os.path.getmtime(dst) >= os.path.getmtime(src)):
        return dst
    os.makedirs(dst_dir, exist_ok=True)
    tmp = dst + ".part"
    with open(src, "rb") as f:
        f.seek(offset)
        with open(tmp, "wb") as g:
            remaining = length
            while remaining > 0:
                chunk = f.read(min(1 << 20, remaining))
                if not chunk:
                    break
                g.write(chunk)
                remaining -= len(chunk)
            if remaining:
                os.unlink(tmp)
                raise NsaError(f"条目 {name} 在 {arc} 里读不满 {length} 字节")
    os.replace(tmp, dst)
    return dst


def nsadec_extract_one(game_root, arc, name, dst_dir):
    """Fallback for compressed entries: run the engine's nsadec in a temp
    directory (it unpacks the whole archive) and copy just our entry out.
    Returns the extracted path or raises NsaError."""
    tool = _nsadec_bin()
    if not os.path.exists(tool):
        raise NsaError("压缩条目需要 nsadec（跑 gal/prep/tools/build-nsatools.sh）")
    import tempfile
    with tempfile.TemporaryDirectory(prefix="gal-nsadec-") as td:
        try:
            proc = subprocess.run([tool, os.path.join(game_root, arc)],
                                  cwd=td, capture_output=True, text=True,
                                  timeout=NSADECODE_TIMEOUT)
        except (OSError, subprocess.TimeoutExpired) as e:
            raise NsaError(f"nsadec 失败: {e}")
        want = os.path.join(td, *name.split("/"))
        if not os.path.exists(want):
            raise NsaError("nsadec 没解出该条目: " +
                           (proc.stderr or "").strip()[:120])
        disk_name = (arc + "!" + name).replace("/", "_").replace("\\", "_")
        dst = os.path.join(dst_dir, disk_name)
        os.makedirs(dst_dir, exist_ok=True)
        shutil.copyfile(want, dst)
        return dst


def out_name_for(rel, used):
    """_video/<original name>.mp4; on a basename collision the flattened
    relative path is used so two nested movies never share one output.

    `rel` is the map spelling ('/' separators, '\\' folded to '/').  A file
    whose real name contains a backslash therefore gets an output name with
    '_' there instead: the map's `from` stays T1-normalised (T1 treats '\\'
    and '/' as equal), and no output path ever carries a stray backslash."""
    base = os.path.splitext(os.path.basename(rel))[0] + ".mp4"
    base = base.replace("\\", "_")
    if base not in used:
        used.add(base)
        return base
    flat = rel.replace("/", "_").replace("\\", "_")
    base = os.path.splitext(flat)[0] + ".mp4"
    used.add(base)
    return base


def load_video_map(map_path):
    """Existing mappings; unreadable or malformed maps are rebuilt from
    scratch (T1 ignores bad entries anyway, and we own this file)."""
    try:
        with open(map_path, "r", encoding="utf-8") as f:
            data = json.load(f)
        if isinstance(data, dict) and data.get("version") == VIDEO_MAP_VERSION:
            entries = data.get("mappings")
            if isinstance(entries, list):
                return [e for e in entries if isinstance(e, dict)
                        and e.get("from") and e.get("to")]
    except (OSError, ValueError):
        pass
    return []


def write_video_map(map_path, entries):
    """Atomic write, format exactly per DESIGN-VIDEO.md (version 1)."""
    doc = {"version": VIDEO_MAP_VERSION,
           "mappings": [{"from": e["from"], "to": e["to"],
                         "codec": e.get("codec", "h264"),
                         "source": e.get("source", "loose")}
                        for e in sorted(entries, key=lambda x: x["from"])]}
    tmp = map_path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(doc, f, ensure_ascii=False, indent=2)
        f.write("\n")
    os.replace(tmp, map_path)
    return doc


def _hide_root(text, game_path):
    """Error text goes into the report and the terminal; keep the game's own
    absolute path out of it - the relative name says enough."""
    return text.replace(game_path + "/", "").replace(game_path, ".")


def do_prep(game_path, game_name=None, quiet=False):
    """Run the whole preprocessing pass over one game folder.

    Returns (report, exit_code); the report is the --report json document.
    Never touches anything outside <game>/_video/."""
    game_path = os.path.abspath(game_path)
    report = {"game": game_name or os.path.basename(game_path),
              "root": game_path,
              "map": f"{VIDEO_OUT_DIR}/{VIDEO_MAP_NAME}",
              "generated": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
              "tools": {"ffmpeg": ffmpeg_bin(), "ffprobe": ffprobe_bin()},
              "videos": [], "counts": {}}
    if not os.path.isdir(game_path):
        report["error"] = f"不是目录: {game_path}"
        return report, 1
    if not ffmpeg_bin() or not ffprobe_bin():
        report["error"] = "ffmpeg/ffprobe 不存在（brew install ffmpeg）"
        return report, 1

    out_dir = os.path.join(game_path, VIDEO_OUT_DIR)
    os.makedirs(out_dir, exist_ok=True)
    map_path = os.path.join(out_dir, VIDEO_MAP_NAME)

    rels = find_videos(game_path)
    # nsa/ns2 in the game root are an NScripter trait; scanning the root for
    # them is a no-op for every other engine.  GAL_PREP_NO_NSA=1 opts out.
    arch_items, broken_archives = ([], [])
    if os.environ.get("GAL_PREP_NO_NSA") != "1":
        arch_items, broken_archives = nsa_video_entries(game_path)
    loose_names = {m for _, m in rels}
    map_names = loose_names | {e[1] for e in arch_items}
    prev = {e["from"]: e for e in load_video_map(map_path)}
    # names already committed stay reserved, so a re-run never renames output
    used = {os.path.basename(e["to"]) for e in prev.values()}
    # entries no producer wrote this pass (e.g. nsa from another tool, or an
    # archive we skipped via GAL_PREP_NO_NSA) survive; everything we re-scan
    # below is recomputed from the folder
    merged = {k: v for k, v in prev.items() if k not in map_names}

    def assign_name(map_rel):
        """Reuse the committed name when the mapping still exists; the
        flattened rel keeps nested collisions from sharing one output."""
        committed = prev.get(map_rel)
        if committed:
            name = os.path.basename(committed["to"]).replace("\\", "_")
            used.add(name)
            return name
        return out_name_for(map_rel, used)

    # one work list, loose first; archive items are shadowed by loose files of
    # the same script-side name (the game's own copy wins, like at runtime)
    work = [("loose", map_from, None) for _disk_rel, map_from in rels]
    extract_dir = os.path.join(out_dir, "extracted")
    seen_arch = set()
    for (arc, ename, off, ln, comp, strip) in sorted(arch_items, key=lambda t: t[1]):
        if ename in loose_names or ename in seen_arch:
            if ename in seen_arch:
                entry = {"file": ename, "origin": f"nsa:{arc}#{ename}",
                         "status": "duplicate", "to": None, "error": None}
                report["videos"].append(entry)
            continue
        seen_arch.add(ename)
        work.append(("nsa", ename, (arc, off, ln, comp, strip)))

    for kind, map_rel, ainfo in work:
        entry = {"file": map_rel, "origin": "loose" if kind == "loose"
                 else f"nsa:{ainfo[0]}#{map_rel}",
                 "to": None, "source_codec": None,
                 "source_size": None, "sar": None, "dar": None,
                 "fps": None, "duration_sec": None, "status": None,
                 "encoder": None, "elapsed_sec": None, "output_bytes": None,
                 "error": None}
        dst_name = assign_name(map_rel)
        dst = os.path.join(out_dir, dst_name)
        entry["to"] = f"{VIDEO_OUT_DIR}/{dst_name}"
        if kind == "loose":
            disk_rel = next(r for r, m in rels if m == map_rel)
            src = os.path.join(game_path, disk_rel)
            if disk_rel != map_rel:
                entry["disk_file"] = disk_rel
        else:
            arc, off, ln, comp, strip = ainfo
            src = None
            try:
                if comp == 0:
                    # off/ln were already moved past the wrapper (e.g. the
                    # AVI8 header) by nsa_video_entries when it sniffed one
                    src = extract_nsa_entry(game_path, arc, map_rel, off, ln,
                                            extract_dir)
                else:
                    # nsadec decodes the payload from the archive; sniff it
                    # again here because the wrapper offset could not be read
                    # through the compression
                    src = nsadec_extract_one(game_path, arc, map_rel,
                                             extract_dir)
                    with open(src, "rb") as f:
                        s = sniff_video_payload(f.read(NSA_SNIFF_BYTES))
                    strip_extracted(src, s or 0)
                entry["extracted_bytes"] = os.path.getsize(src)
            except (NsaError, OSError) as e:
                entry.update(status="extract_failed",
                             error=_hide_root(str(e), game_path))
                report["videos"].append(entry)
                continue
        try:
            info = probe_media(src)
        except ProbeError as e:
            # the source cannot be decoded here; if an earlier run left a good
            # transcode behind, keep its mapping - the engine can still play it
            committed = prev.get(map_rel)
            if committed and committed.get("to") == entry["to"] and should_skip(src, dst):
                merged[map_rel] = {"from": map_rel, "to": entry["to"],
                                   "codec": "h264", "source": entry["origin"]}
                entry["output_bytes"] = os.path.getsize(dst)
            entry.update(status="unprobeable", error=_hide_root(str(e), game_path))
            report["videos"].append(entry)
            continue
        entry.update(source_codec=info["codec"],
                     source_size=f"{info['width']}x{info['height']}",
                     sar=info["sar"], dar=info["dar"], fps=info["fps"],
                     duration_sec=info["duration"])
        if should_skip(src, dst):
            entry["status"] = "skipped"
        else:
            rec = transcode_one(src, dst, info)
            entry.update(status=rec["status"], encoder=rec["encoder"],
                         elapsed_sec=rec["elapsed_sec"], attempts=rec["attempts"],
                         filter=rec["filter"], target_size=rec["target"])
            if rec["status"] != "transcoded":
                entry["error"] = _hide_root(rec["error"] or "", game_path)
                for a in entry["attempts"]:
                    if a.get("error"):
                        a["error"] = _hide_root(a["error"], game_path)
        if entry["status"] in ("transcoded", "skipped"):
            try:
                entry["output_bytes"] = os.path.getsize(dst)
            except OSError:
                entry["output_bytes"] = None
            merged[map_rel] = {"from": map_rel, "to": entry["to"],
                               "codec": "h264", "source": entry["origin"]}
        report["videos"].append(entry)

    for arc in broken_archives:
        entry = {"file": arc, "origin": "archive", "status": "archive_broken",
                 "to": None, "error": "头解析失败（可能是 key_table 加密或坏档）"}
        report["videos"].append(entry)

    map_doc = write_video_map(map_path, list(merged.values()))
    # "found" must cover archive entries too, otherwise a game whose only
    # movies live in arc.nsa reports "共 0 个影片：转码 1".
    counts = {"found": len(rels) + len(seen_arch), "transcoded": 0, "skipped": 0,
              "failed": 0, "unprobeable": 0,
              "found_in_archives": len(seen_arch),
              "archives": sorted({a[0] for a in arch_items}) ,
              "broken_archives": broken_archives,
              "mapped": len(map_doc["mappings"])}
    for v in report["videos"]:
        if v["status"] == "transcoded":
            counts["transcoded"] += 1
        elif v["status"] == "skipped":
            counts["skipped"] += 1
        elif v["status"] == "unprobeable":
            counts["unprobeable"] += 1
        else:
            counts["failed"] += 1
    report["counts"] = counts
    rc = 0 if counts["failed"] == 0 and counts["unprobeable"] == 0 else 1
    if not quiet:
        print_prep_table(report)
    return report, rc


def _dwidth(s):
    """Display width in columns (CJK labels count as two)."""
    return sum(2 if unicodedata.east_asian_width(c) in ("W", "F") else 1
               for c in s)


def _pad(s, w):
    return s + " " * max(0, w - _dwidth(s))


def print_prep_table(report):
    rows = [("文件", "源", "分辨率", "时长", "状态", "编码器", "耗时", "产物")]
    for v in report["videos"]:
        rows.append((
            v["file"],
            v["source_codec"] or "-",
            f"{v['source_size']}→{v.get('target_size', '')}" if v.get("target_size")
            else (v["source_size"] or "-"),
            human_dur(v["duration_sec"]),
            {"transcoded": "转码", "skipped": "跳过(幂等)", "failed": "失败",
             "unprobeable": "不可解码"}.get(v["status"], v["status"] or "-"),
            v["encoder"] or "-",
            f"{v['elapsed_sec']:.1f}s" if v["elapsed_sec"] else "-",
            human_bytes(v["output_bytes"]),
        ))
    widths = [max(_dwidth(r[i]) for r in rows) for i in range(len(rows[0]))]
    for n, r in enumerate(rows):
        print("  ".join(_pad(c, widths[i]) for i, c in enumerate(r)).rstrip())
        if n == 0:
            print("  ".join("-" * w for w in widths))
    c = report["counts"]
    print(f"共 {c['found']} 个影片：转码 {c['transcoded']}，跳过 {c['skipped']}，"
          f"失败 {c['failed']}，映射 {c['mapped']} 条 -> {report['map']}")
    for v in report["videos"]:
        if v["status"] in ("failed", "unprobeable") and v.get("error"):
            print(f"  ! {v['file']}: {v['error'][:160]}")


def resolve_game_dir(name_or_path):
    """A library name or a direct folder; returns (name, abspath) or None."""
    lib = load_library()
    if name_or_path in lib["games"]:
        return name_or_path, lib["games"][name_or_path]["path"]
    path = os.path.abspath(os.path.expanduser(name_or_path))
    if os.path.isdir(path):
        return os.path.basename(path.rstrip("/")), path
    return None


