def cmd_savetest(args):
    """Thin forwarder to the task-3 harness (harness/run_savetest.sh).

    Extension point for T3: the harness owns everything under harness/; gal
    only resolves the game folder and runs
        harness/run_savetest.sh <game_root>
    and passes -- through.  Until the script exists this reports 待接入."""
    hit = resolve_game_dir(args.game)
    if hit is None:
        print(f"gal: 库里没有 {args.game}，也不是一个目录: {args.game}",
              file=sys.stderr)
