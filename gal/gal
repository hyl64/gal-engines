def load_library():
    try:
        with open(LIBRARY, "r", encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return {"games": {}}


def save_library(lib):
    os.makedirs(os.path.dirname(LIBRARY), exist_ok=True)
    tmp = LIBRARY + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(lib, f, ensure_ascii=False, indent=2)
    os.replace(tmp, LIBRARY)


# ---------------------------------------------------------------------------
# video preprocessing  (gal prep)
# ---------------------------------------------------------------------------
#
# NScripter-era games ship their movies as .avi/.mpg/.mpeg, which the Mac
# ports cannot play (no smpeg, no avifile, and Homebrew deprecated both).
# `gal prep` transcodes them once, ahead of time, into H.264 MP4s under
# <game>/_video/, and writes <game>/_video/video_map.json so the engine can
# look up "the file the script names" -> "the file that actually plays".
# The map format is fixed by gal-engines/DESIGN-VIDEO.md (version 1); do not
# improvise fields here.
#
# Pipeline per file:
#   ffprobe -> codec/SAR/DAR/fps/field order/audio/duration
#   ffmpeg  -> yadif (if the source is interlaced) + scale to the display
#              size with square pixels + h264_videotoolbox (hardware);
#   on failure retry the same chain with libx264 -preset veryfast.
# Idempotent: if the .mp4 already exists and is newer than the source, and
# ffprobe still reads it, the file is skipped and only (re-)registered.
#
# GAL_FFMPEG_BIN / GAL_FFPROBE_BIN override the tool paths (used by the
# self-test to inject a failing-encoder shim); GAL_PREP_SOFT_ONLY=1 skips the
# hardware attempt; GAL_PREP_FFMPEG_TIMEOUT overrides the per-file timeout.

VIDEO_EXTS = (".avi", ".mpg", ".mpeg")
VIDEO_OUT_DIR = "_video"
VIDEO_MAP_NAME = "video_map.json"
VIDEO_MAP_VERSION = 1
PROBE_TIMEOUT = 30
FFMPEG_TIMEOUT = 900

