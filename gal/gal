def build_command(name, game, extra):
    """The binary, argv and working directory that start this game."""
    info = ENGINES[game["engine"]]
    binary = info["binary"]
    path = game["path"]
    if game["engine"] == "nscripter":
        argv = [binary, "--root", path] + info["extras"]
        return argv, path
    if game["engine"] == "kirikiri" and os.path.isfile(path):
        return [binary, path] + info["extras"], info.get("cwd") or os.path.dirname(path)
    if game["engine"] == "kirikiri":
        # a game ships as data.xp3 (or a name of its own); the port can run one
        archives = sorted(f for f in os.listdir(path) if f.lower().endswith(".xp3")) \
            if os.path.isdir(path) else []
        if archives:
            primary = os.path.join(path, "data.xp3")
            chosen = primary if os.path.exists(primary) else os.path.join(path, archives[0])
            return [binary, chosen] + info["extras"], path
        # otherwise the project's sources sit in the folder, starting at startup.tjs
        entry = os.path.join(path, "startup.tjs")
        if not os.path.exists(entry):
            entry = None
            for root, dirs, files in os.walk(path):
                for f in sorted(files):
                    if f == "startup.tjs":
                        entry = os.path.join(root, f)
                        break
                if entry:
                    break
        argv = [binary] + ([entry] if entry else [])
        return argv, path
    if game["engine"] == "artemis":
        # the player takes a script; the game's own are under root/script
        script = None
        for root, dirs, files in os.walk(path):
            for f in sorted(files):
                if f.endswith(".ast"):
                    script = os.path.join(root, f)
                    break
            if script:
                break
        if script is None:
            return [binary], path
        return [binary, script] + info["extras"], path
    if game["engine"] == "bgi":
        # the BGI engine reads the game's files from its working directory
        return [binary] + info["extras"], path
    return [binary] + info["extras"], path


def cmd_launch(args):
    lib = load_library()
    game = lib["games"].get(args.game)
    if game is None:
        print(f"gal: 库里没有 {args.game}", file=sys.stderr)
        return 1
    engine = game["engine"]
    info = ENGINES.get(engine, {})
    if engine not in RUNNABLE:
        print(f"gal: {info.get('label', engine)} 还跑不了游戏", file=sys.stderr)
        print(f"gal: {info.get('notes', '')}", file=sys.stderr)
        return 1
    binary = info["binary"]
    if not os.path.exists(binary):
        print(f"gal: 引擎二进制不存在: {binary}", file=sys.stderr)
        print("gal: 先在对应引擎目录里构建（见各目录的 BUILD_NOTES.md）", file=sys.stderr)
        return 1
    if not os.path.exists(game["path"]):
        print(f"gal: 游戏不在了: {game['path']}", file=sys.stderr)
        return 1
    # BGI trials ship as installers: the engine boots them and their own boot
    # program then asks for the installation media and quits
    if game["engine"] == "bgi":
        # a trial often ships as an installer next to already-installed data; only
        # refuse when nothing installed is there
        path_now = game["path"]
        has_data = any(f.startswith("data") and f.endswith(".arc")
                       for f in os.listdir(path_now)) if os.path.isdir(path_now) else False
        if not has_data:
            for marker in ("Setup.exe", "BGIForInstalling.exe"):
                if os.path.exists(os.path.join(path_now, marker)):
                    print(f"gal: {args.game} 是安装包，还没有装出游戏数据", file=sys.stderr)
                    print("gal: 请指向安装后的目录（含 data*.arc）", file=sys.stderr)
                    return 1
    # NScripter writes its cross-platform save into <game>/sav/ and silently
    # gives up when that directory is missing -- it then only keeps the private
    # ONScripter format next to the script, which the Windows original cannot
    # read.  Creating it costs nothing and is what makes the saves portable.
    # (Measured: harness/results.md, "存档落在哪里".)
    if engine == "nscripter":
        sav_dir = os.path.join(game["path"], "sav")
        if not os.path.isdir(sav_dir):
            try:
                os.makedirs(sav_dir, exist_ok=True)
                print(f"gal: 已创建存档目录 {sav_dir}（NScripter 兼容存档写这里）")
            except OSError as e:
                print(f"gal: 建不了存档目录 {sav_dir}: {e}", file=sys.stderr)
    argv, cwd = build_command(args.game, game, args.extra)
    # the KiriKiri port processes the framework's timer-driven execution in a loop,
    # so it is given one for as long as the window is up
    run_env = dict(os.environ)
    if game["engine"] == "kirikiri":
        run_env.setdefault("KRKR_LOOP_SECONDS", "600")
    else:
        run_env = None
    if getattr(args, "dump", None):
        out = os.path.abspath(args.dump)
        # the KiriKiri port takes --screenshot and the BGI engine writes the surface
        # it draws; either way a title can be looked at with no screen
        if engine == "kirikiri":
            env = dict(os.environ)
            env.setdefault("SDL_VIDEODRIVER", "dummy")
            env.setdefault("KRKR_LOOP_SECONDS", "3")
            rc = subprocess.call(argv + ["--screenshot", out], cwd=cwd, env=env,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            ok = os.path.exists(out) and os.path.getsize(out) > 1024
            print(f"gal: {'已导出' if ok else '没有导出'} {out}")
            return 0 if ok else 1
        if engine != "bgi":
            print(f"gal: {engine} 不支持无头导出画面", file=sys.stderr)
            return 1
        env = dict(os.environ)
        env["BGI_DUMP_STAGE"] = os.path.abspath(args.dump)
        env.setdefault("SDL_VIDEODRIVER", "dummy")
        # Do not terminate an unrelated game with pkill -f bin/bgi.  If another
        # instance holds the engine lock, this probe will fail honestly.
        proc = subprocess.Popen(argv, cwd=cwd, env=env,
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        try:
            proc.wait(timeout=14)
        except subprocess.TimeoutExpired:
            proc.terminate()
            try:
                proc.wait(timeout=2)
            except subprocess.TimeoutExpired:
                proc.kill()
                proc.wait()
        ok = os.path.exists(args.dump) and os.path.getsize(args.dump) > 1024
        print(f"gal: {'已导出' if ok else '没有导出'} {args.dump}")
        return 0 if ok else 1
    if args.dry_run:
        print(f"cwd:  {cwd}")
        print(f"argv: {' '.join(argv)}")
        return 0
    print(f"启动 {args.game} → {info['label']}")
    try:
        return subprocess.call(argv, cwd=cwd, env=run_env if run_env else None)
    except KeyboardInterrupt:
        return 130


def cmd_verify(args):
    """Start the engine headless for a few seconds and report what it said."""
    lib = load_library()
    game = lib["games"].get(args.game)
    if game is None:
        print(f"gal: 库里没有 {args.game}", file=sys.stderr)
        return 1
    engine = game["engine"]
    info = ENGINES.get(engine, {})
    if engine not in RUNNABLE:
        print(f"gal: {info.get('label', engine)} 还跑不了游戏", file=sys.stderr)
        return 1
    argv, cwd = build_command(args.game, game, [])
    # the same environment a launch gets: the KiriKiri port needs its loop to be
    # "still running" at all
    run_env = dict(os.environ)
    if game["engine"] == "kirikiri":
        run_env.setdefault("KRKR_LOOP_SECONDS", "600")
    else:
        run_env = None
    if not os.path.exists(argv[0]) or not (os.path.isdir(cwd) or os.path.isfile(cwd)):
        print("gal: 二进制或游戏目录不存在", file=sys.stderr)
        return 1
    env = dict(run_env if run_env else os.environ)
    env["SDL_VIDEODRIVER"] = "dummy"
    env["SDL_AUDIODRIVER"] = "dummy"
    quiet_json = getattr(args, "report", None) == "json"
    if not quiet_json:
        print(f"试跑 {args.seconds}s（无窗口）: {args.game}")
    try:
        proc = subprocess.Popen(argv, cwd=cwd, env=env,
                                stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                text=True, errors="replace")
    except OSError as e:
        print(f"gal: 启动失败: {e}", file=sys.stderr)
        return 1
    started = time.monotonic()
    try:
        out, _ = proc.communicate(timeout=args.seconds)
        # the engine exiting on its own inside the window means it ran a script
        # that ends, which is a pass too - unless it gave up straight away,
        # which is what a missing data file looks like: the engine's own error
        # box can be suppressed, so the quiet early exit is the only clue
        timed_out = False
    except subprocess.TimeoutExpired:
        proc.kill()
        out, _ = proc.communicate()
        timed_out = True
    elapsed = time.monotonic() - started
    lines = [l for l in (out or "").splitlines() if l.strip()]
    # Survival is not a compatibility test.  Catch explicit engine/script
    # failures (including KiriKiri's Japanese exception banner) even when the
    # host keeps its run loop alive or exits with status zero.  Lines matching
    # VERIFY_WARN_MARKERS are engine noise about optional resources and only
    # get reported, never counted against the verdict - that set is a graded
    # placeholder until task-3's corpus and the lead's whitelist land.
    lowered = [(l, l.lower()) for l in lines]
    errors = [l for l, low in lowered
              if any(m in low for m in VERIFY_ERROR_MARKERS)]
    warn_res = [re.compile(pat, re.I) for pat in VERIFY_WARN_PATTERNS]
    warns = [l for l, low in lowered
             if (any(m in low for m in VERIFY_WARN_MARKERS)
                 or any(r.search(low) for r in warn_res))
             and not any(m in low for m in VERIFY_ERROR_MARKERS)]
    if proc.returncode not in (None, 0) and not timed_out:
        errors.append(f"engine exited with status {proc.returncode}")
    if errors:
        verdict, ok = f"✗ 有报错（{len(errors)} 条）", False
    elif timed_out:
        verdict, ok = f"✓ 进入主循环（活过 {elapsed:.1f}s）", True
    elif elapsed < 2.0:
        verdict, ok = f"⚠ 启动后 {elapsed:.1f}s 就退出：多半缺数据或脚本出错被抑制", False
    else:
        verdict, ok = f"✓ 脚本正常结束（跑了 {elapsed:.1f}s）", True
    if quiet_json:
        print(json.dumps({
            "game": args.game, "engine": engine, "seconds": args.seconds,
            "elapsed_sec": round(elapsed, 2), "returncode": proc.returncode,
            "timed_out": timed_out, "line_count": len(lines),
            "verdict": "pass" if ok else "fail", "ok": ok,
            "errors": [e.strip() for e in errors],
            "warnings": [w.strip() for w in warns],
        }, ensure_ascii=False, indent=2))
        return 0 if ok else 1
    if errors:
        print("  ✗ 有报错:")
        for l in errors[:5]:
            print(f"    {l.strip()}")
        print("  结论: 跑不起来")
        return 1
    print(f"  {verdict} ({len(lines)} 行输出)")
    for l in lines[:3]:
        print(f"    {l.strip()}")
    for w in warns[:3]:
        print(f"    (可选资源/噪音) {w.strip()}")
    print(f"  结论: {'可以运行' if ok else '不算跑通'}")
    return 0 if ok else 1


def cmd_remove(args):
    lib = load_library()
    if args.game not in lib["games"]:
        print(f"gal: 库里没有 {args.game}", file=sys.stderr)
        return 1
    del lib["games"][args.game]
    save_library(lib)
    print(f"已移除: {args.game}")
    return 0


def cmd_doctor(args):
    ok = True
    print("引擎二进制:")
    for name, info in ENGINES.items():
        binary = info["binary"]
        if binary is None:
            print(f"  · {name}: 还没有实现")
            continue
        exists = os.path.exists(binary)
        ok = ok and exists
        mark = "✓" if exists else "✗"
        print(f"  {mark} {name}: {binary}")
    print("\n自检:")
    for tool in ("cmake", "brew", "ffmpeg", "ffprobe"):
        print(f"  {'✓' if shutil.which(tool) else '✗'} {tool}"
              + ("" if tool not in ("ffmpeg", "ffprobe")
                 else "   (gal prep 需要)"))
    lib = load_library()
    # a game may be an archive file rather than a folder
    missing = [n for n, g in lib["games"].items() if not os.path.exists(g["path"])]
    for n in missing:
        print(f"  ✗ {n}: 目录不在了 ({lib['games'][n]['path']})")
        ok = False
    if not missing:
        print(f"  ✓ 库里的 {len(lib['games'])} 个游戏目录都在")
    return 0 if ok else 1


# ---------------------------------------------------------------------------

def main(argv):
    parser = argparse.ArgumentParser(prog="gal", description="galgame 运行时管理器")
    sub = parser.add_subparsers(dest="cmd", required=True)

    sub.add_parser("engines", help="引擎状态").set_defaults(func=cmd_engines)

    p = sub.add_parser("add", help="把一个游戏目录加进库")
    p.add_argument("directory")
    p.add_argument("--name", help="库里的名字（默认用目录名）")
    p.add_argument("--no-prep", action="store_true",
                   help="识别引擎后不自动做影片预处理（目前只对 NScripter 生效）")
    p.set_defaults(func=cmd_add)

    p = sub.add_parser("prep", help="把游戏里的 .avi/.mpg/.mpeg 预转码到 _video/ 并写 video_map.json")
    p.add_argument("game", metavar="game|path", help="库里的名字或游戏目录")
    p.add_argument("--report", choices=["table", "json"], default="table",
                   help="table（默认，给人看）或 json（机器可读，含源codec/分辨率/时长/耗时/产物大小）")
    p.set_defaults(func=cmd_prep)

    p = sub.add_parser("savetest", help="存读档往返测试（转发 harness/run_savetest.sh，由 task-3 提供）")
    p.add_argument("game", metavar="game|path")
    p.add_argument("rest", nargs="*", help="-- 之后的参数原样转发给 harness")
    p.set_defaults(func=cmd_savetest)

    sub.add_parser("list", help="列出库").set_defaults(func=cmd_list)

    p = sub.add_parser("info", help="一个游戏的检测详情")
    p.add_argument("game")
    p.set_defaults(func=cmd_info)

    p = sub.add_parser("play", aliases=["launch"], help="启动游戏")
    p.add_argument("game")
    p.add_argument("--dry-run", action="store_true", help="只打印命令，不启动")
    p.add_argument("--dump", metavar="BMP", help="无头跑几秒，把引擎画的画面存成 BMP（引擎需支持）")
    p.add_argument("extra", nargs="*", help="传给引擎的额外参数")
    p.set_defaults(func=cmd_launch)

    p = sub.add_parser("verify", help="试跑一个游戏看能不能起来")
    p.add_argument("game")
    p.add_argument("--seconds", type=int, default=5, help="试跑多少秒（默认 5）")
    p.add_argument("--report", choices=["table", "json"], default="table",
                   help="table（默认）或 json（含 verdict/errors/warnings，与 gal prep 同风格）")
    p.set_defaults(func=cmd_verify)

    p = sub.add_parser("remove", help="从库里移除")
    p.add_argument("game")
    p.set_defaults(func=cmd_remove)

    sub.add_parser("doctor", help="自检").set_defaults(func=cmd_doctor)

    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
