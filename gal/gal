    name, path = hit
    script = os.environ.get("GAL_SAVETEST_SH") or \
        os.path.join(ENGINES_ROOT, "harness", "run_savetest.sh")
    if not os.path.exists(script):
        print(f"gal: savetest 待接入 — harness/run_savetest.sh 不存在 ({script})")
        print("gal: 该脚本由 task-3 提供；到位后本命令直接转发 <游戏目录> 给它")
        return 2
    argv = [script, path] + list(args.rest or [])
    try:
        return subprocess.call(argv, cwd=ENGINES_ROOT)
    except OSError as e:
        print(f"gal: 无法启动 {script}: {e}", file=sys.stderr)
        return 1


